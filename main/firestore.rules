rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isJournalAdmin() {
      return request.auth != null
        && request.auth.uid == 'pvt5zRlejfg76xXWTXol6vKp59c2';
    }

    match /journalPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isJournalAdmin();
    }

    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
